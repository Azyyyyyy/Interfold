{
  "schemaVersion": 2,
  "deployment": {
    "outputDir": "/opt/deploy",
    "includeWeb": false
  },
  "edge": {
    "hosts": ["api.example.com"],
    "tlsMode": "none",
    "routing": { "mode": "path" },
    "cloudflare": {
      "enabled": true,
      "apiToken": "test-cf-api-token",
      "tunnelName": "interfold-test",
      "access": {
        "enabled": true,
        "allowedEmails": ["ops@example.com"],
        "allowedEmailDomains": ["example.com"]
      }
    },
    "certificates": {
      "rootCaName": "Interfold Test Root CA",
      "certYears": 2,
      "trustStoreInstall": false
    }
  },
  "datastores": {
    "cql": { "backend": "scylla-single" }
  },
  "api": {
    "image": "interfold-api:test",
    "oauth": {
      "googleClientId": "test-google-id.apps.googleusercontent.com",
      "googleClientSecret": "test-google-secret",
      "discordClientSecret": ""
    }
  }
}
