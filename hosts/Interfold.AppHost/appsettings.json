{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Aspire.Hosting.Dcp": "Warning"
    }
  },
  "Parameters": {
    "persistence": "sqlite",
    "include-web": true,
    "edge-routing": "path",
    "persistent-containers": false,
    "web-image": "interfold-wasm:dev"
  },
  "Ports": {
    "edge-http": 80,
    "edge-https": 443
  }
}
