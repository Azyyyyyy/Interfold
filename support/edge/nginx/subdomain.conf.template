# Processed by the nginx image's /docker-entrypoint.d/20-envsubst-on-templates.sh.
# NGINX_ENVSUBST_FILTER=^NGINX_ limits substitution so nginx $vars stay literal.
#
# Vars (InterfoldAppHost when edge is enabled, subdomain routing):
#   NGINX_API_SERVER_NAME     API public hostname
#   NGINX_WEB_SERVER_NAME     Web public hostname
#   NGINX_SSL_CERT_FILE / NGINX_SSL_KEY_FILE
#   NGINX_HTTPS_PORT_SUFFIX
#   NGINX_API_UPSTREAM / NGINX_WEB_UPSTREAM
#   NGINX_INCLUDE_WEB         "1" to enable web server block locations
#   NGINX_ACME_ROOT

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name ${NGINX_API_SERVER_NAME} ${NGINX_WEB_SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location = /nginx-health {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    set $https_port_suffix "${NGINX_HTTPS_PORT_SUFFIX}";
    set $redirect_to_https 0;
    if ($https_port_suffix != "") {
        set $redirect_to_https 1;
    }
    if ($request_uri = /nginx-health) {
        set $redirect_to_https 0;
    }
    if ($request_uri ~ ^/.well-known/acme-challenge/) {
        set $redirect_to_https 0;
    }
    if ($redirect_to_https = 1) {
        return 301 https://$host${NGINX_HTTPS_PORT_SUFFIX}$request_uri;
    }

    return 404;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_API_SERVER_NAME};
    resolver 127.0.0.11 valid=10s ipv6=off;

    ssl_certificate     ${NGINX_SSL_CERT_FILE};
    ssl_certificate_key ${NGINX_SSL_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    location = /nginx-health {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    location /health/ {
        set $api_upstream http://${NGINX_API_UPSTREAM};
        proxy_pass $api_upstream;
        include /etc/nginx/proxy_params_interfold.conf;
    }

    location / {
        set $api_upstream http://${NGINX_API_UPSTREAM};
        proxy_pass $api_upstream;
        include /etc/nginx/proxy_params_interfold.conf;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_WEB_SERVER_NAME};
    resolver 127.0.0.11 valid=10s ipv6=off;

    ssl_certificate     ${NGINX_SSL_CERT_FILE};
    ssl_certificate_key ${NGINX_SSL_KEY_FILE};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    location = /nginx-health {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    location / {
        set $include_web "${NGINX_INCLUDE_WEB}";
        if ($include_web = "") {
            return 404;
        }
        set $web_upstream http://${NGINX_WEB_UPSTREAM};
        proxy_pass $web_upstream;
        include /etc/nginx/proxy_params_interfold.conf;
    }
}
