# Plaintext edge (tlsMode=none): :80 only, no TLS redirect or :443 server block.
# Vars: same as path.conf.template except NGINX_SSL_* and NGINX_HTTPS_PORT_SUFFIX are unused.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Cloudflare already set X-Forwarded-Proto / CF-Visitor; $scheme is http on compose.
map $http_x_forwarded_proto $interfold_forwarded_proto {
    default $http_x_forwarded_proto;
    ''      $cf_visitor_scheme;
}

map $http_cf_visitor $cf_visitor_scheme {
    default $scheme;
    ~*"scheme"\s*:\s*"https" https;
    ~*"scheme"\s*:\s*"http"  http;
}

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};
    resolver 127.0.0.11 valid=10s ipv6=off;

    location = /nginx-health {
        access_log off;
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    location /health/ {
        set $api_upstream http://${NGINX_API_UPSTREAM};
        proxy_pass $api_upstream;
        include /etc/nginx/proxy_params_interfold.conf;
    }

    # SPA OAuth landing (redirect_uri?token=&id=). The rest of /auth is Kestrel.
    location = /auth/token {
        set $include_web "${NGINX_INCLUDE_WEB}";
        if ($include_web = "") {
            return 404;
        }
        set $web_upstream http://${NGINX_WEB_UPSTREAM};
        proxy_pass $web_upstream;
        include /etc/nginx/proxy_params_interfold.conf;
    }

    location /auth/ {
        set $api_upstream http://${NGINX_API_UPSTREAM};
        proxy_pass $api_upstream;
        include /etc/nginx/proxy_params_interfold.conf;
    }

    # Fold a leftover origin+/api client base onto the real /api/ prefix.
    location /api/api/ {
        rewrite ^/api/api/(.*)$ /api/$1 last;
    }

    location /api/ {
        set $api_upstream http://${NGINX_API_UPSTREAM};
        proxy_pass $api_upstream;
        include /etc/nginx/proxy_params_interfold.conf;
    }

    location /.well-known/interfold-root-ca.crt {
        set $api_upstream http://${NGINX_API_UPSTREAM};
        proxy_pass $api_upstream;
        include /etc/nginx/proxy_params_interfold.conf;
    }
    location /.well-known/interfold-root-ca.pem {
        set $api_upstream http://${NGINX_API_UPSTREAM};
        proxy_pass $api_upstream;
        include /etc/nginx/proxy_params_interfold.conf;
    }
    location /.well-known/interfold-root-ca.sha256 {
        set $api_upstream http://${NGINX_API_UPSTREAM};
        proxy_pass $api_upstream;
        include /etc/nginx/proxy_params_interfold.conf;
    }

    location / {
        set $include_web "${NGINX_INCLUDE_WEB}";
        if ($include_web = "") {
            return 404;
        }
        set $web_upstream http://${NGINX_WEB_UPSTREAM};
        proxy_pass $web_upstream;
        include /etc/nginx/proxy_params_interfold.conf;
    }
}
