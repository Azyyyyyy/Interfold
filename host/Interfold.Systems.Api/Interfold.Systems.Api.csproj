<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- Mirror the implicit usings Microsoft.NET.Sdk.Web adds. Interfold.Systems.Api is a plain
       Microsoft.NET.Sdk library (no Kestrel), but the moved PublicSystemsController assumes the
       Web-SDK implicits are present. Same shape as Interfold.Alters.Api / Interfold.Friendships.Api /
       Interfold.Fronting.Api / Interfold.Journals.Api / Interfold.Polls.Api / Interfold.Tags.Api. -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Interfold.Api.Shared\Interfold.Api.Shared.csproj" />
    <ProjectReference Include="..\..\shared\Interfold.Systems.Contracts\Interfold.Systems.Contracts.csproj" />
    <!-- Facade module reaches Interfold.Domain directly for the five repository interfaces
         PublicSystemsController + SystemMustExistAttribute consume (IAccountRepository,
         IAlterRepository, ITagRepository, IFrontingRepository, IFriendshipRepository) — the
         module has no .Domain project of its own (no owned handlers, no owned abstractions).
         Ops (#11) will follow this same shape. -->
    <ProjectReference Include="..\..\shared\Interfold.Domain\Interfold.Domain.csproj" />
    <!-- Feature Contracts the controller binds directly: BareAlter (Alters), TagId +
         TagPublicReadModel (Tags), FrontActiveReadModel (Fronting), FriendshipReadModel
         (Friendships). All reachable transitively via Systems.Contracts too — but explicit
         refs keep the compile-error surface local to the consuming project when a feature
         Contracts shifts. -->
    <ProjectReference Include="..\..\shared\Interfold.Alters.Contracts\Interfold.Alters.Contracts.csproj" />
    <ProjectReference Include="..\..\shared\Interfold.Tags.Contracts\Interfold.Tags.Contracts.csproj" />
    <ProjectReference Include="..\..\shared\Interfold.Fronting.Contracts\Interfold.Fronting.Contracts.csproj" />
    <ProjectReference Include="..\..\shared\Interfold.Friendships.Contracts\Interfold.Friendships.Contracts.csproj" />
  </ItemGroup>
</Project>
