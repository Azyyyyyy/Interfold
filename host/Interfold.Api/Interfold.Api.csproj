<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <!-- Mirror the implicit usings Microsoft.NET.Sdk.Web adds. Post-Phase-2 the composition
       binary lives in Interfold.Api.Host; this project is now a class library that carries
       the twelve non-Auth feature controllers + socket handler until Phase 3 dismantles it.
       Same shape as Interfold.Api.Shared / Interfold.Auth.Api. -->
  <ItemGroup>
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <Using Include="System.Net.Http.Json" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Interfold.Api.Host" />
    <InternalsVisibleTo Include="Interfold.IntegrationTests" />
    <InternalsVisibleTo Include="Interfold.Api.UnitTests" />
    <PackageReference Include="OneOf" />
    <PackageReference Include="OneOf.SourceGenerator" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <ProjectReference Include="..\..\host\Interfold.Api.Shared\Interfold.Api.Shared.csproj" />
    <!-- Back-ref: WebSocketHandler.cs calls JwtEs256Validator.ValidateSignature. Keeps
         the ES256 validator co-located with the rest of the Auth feature rather than
         forcing it into Interfold.Api.Shared just to satisfy the socket handler. -->
    <ProjectReference Include="..\..\host\Interfold.Auth.Api\Interfold.Auth.Api.csproj" />
    <!-- Back-refs: six tag-touching files still live in this project until the Socket +
         Systems + Settings features migrate — TagSocketEventHandlers, SocketEventPumpRunner,
         WebSocketHandler, WebSocketInitialization, PublicSystemsController, and
         SimplyPluralImportService. Dissolves when Settings (#7) + Systems (#8) + Socket
         (#10) all land and the last tag-typed line leaves Interfold.Api. Tags.Contracts is
         also visible transitively via Interfold.Domain; kept explicit so a future
         Interfold.Domain -> Tags.Contracts dissolution doesn't cascade here. -->
    <ProjectReference Include="..\..\shared\Interfold.Tags.Contracts\Interfold.Tags.Contracts.csproj" />
    <ProjectReference Include="..\..\shared\Interfold.Tags.Domain\Interfold.Tags.Domain.csproj" />
    <!-- Back-refs: four poll-touching files still live in this project until Socket +
         Systems + Settings migrate — PollSocketEventHandlers (socket handler),
         SocketEventPumpRunner + WebSocketHandler (socket transport carrying Poll events),
         SimplyPluralImportService (import path constructs CreatePollCommand). Dissolves
         when Settings (#7) + Systems (#8) + Socket (#10) all land. Polls.Contracts is
         also visible transitively via Interfold.Domain; kept explicit so a future
         Interfold.Domain -> Polls.Contracts dissolution doesn't cascade here. -->
    <ProjectReference Include="..\..\shared\Interfold.Polls.Contracts\Interfold.Polls.Contracts.csproj" />
    <ProjectReference Include="..\..\shared\Interfold.Polls.Domain\Interfold.Polls.Domain.csproj" />
    <ProjectReference Include="..\..\shared\Interfold.Domain\Interfold.Domain.csproj" />
    <ProjectReference Include="..\..\infrastructure\Interfold.Infrastructure.InMemory\Interfold.Infrastructure.InMemory.csproj" />
    <ProjectReference Include="..\..\infrastructure\Interfold.Infrastructure.Postgres\Interfold.Infrastructure.Postgres.csproj" />
    <ProjectReference Include="..\..\infrastructure\Interfold.Infrastructure.Scylla\Interfold.Infrastructure.Scylla.csproj" />
    <ProjectReference Include="..\..\shared\Interfold.Infrastructure\Interfold.Infrastructure.csproj" />
    <ProjectReference Include="..\..\host\Interfold.ServiceDefaults\Interfold.ServiceDefaults.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Placeholder so Docker volume-init sees a pre-created /app/data/avatars with app:app perms;
         see InterfoldAppHost.ConfigureApiSelfHostEnv. Composition host owns the publish now. -->
    <None Include="data\avatars\.gitkeep" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
