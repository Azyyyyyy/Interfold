# Shell scripts must use LF (they run in Linux containers)
*.sh text eol=lf

# systemd units / drop-ins are parsed on Linux; CRLF in a Windows checkout
# would be baked into a linux-x64 publish of the bootstrapper.
*.service text eol=lf
*.timer text eol=lf
tools/Interfold.Bootstrapper/Phases/SystemdTemplates/*.conf text eol=lf

# Embedded in the infrastructure assemblies; SHA-256 of LF-normalized
# bytes is the schema_migrations checksum. CRLF on a Windows checkout or
# Docker context would fail startup against a Linux-built ledger.
*.cql text eol=lf
*.sql text eol=lf
